# Copy to .env and adjust. Never commit the real .env file.
FLASK_APP=run.py
FLASK_ENV=development

# MySQL:      mysql+pymysql://user:password@localhost:3306/hospital_flow
# PostgreSQL: postgresql+psycopg2://user:password@localhost:5432/hospital_flow
# Leave empty to fall back to a local SQLite file (prototyping only).
DATABASE_URL=

SECRET_KEY=change-me

# Business rule (kept out of the database schema on purpose)
TOP_N_PREPARATION_WINDOW=5
